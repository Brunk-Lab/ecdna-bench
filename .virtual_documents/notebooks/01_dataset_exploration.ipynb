    ncol=3,
    frameon=False,
    fontsize=5.8
)

title = f'{canonical_cell_line(anchor_row.get("cell_line", ""))} anchor image'
if anchor_count is not None:
    title += f' | ecDNA_gt = {anchor_count:,}'

fig.suptitle(title, y=1.02, fontsize=8)

fig.tight_layout()

display(fig)

