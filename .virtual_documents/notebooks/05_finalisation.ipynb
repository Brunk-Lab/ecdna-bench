            Path(d) / f'{uid}.png',
            Path(d) / f'{uid}.PNG',
        ])

    safe = (
        model.replace(' ', '_')
        .replace('(', '')
        .replace(')', '')
        .replace('/', '_')
    )

    candidates.extend([
        _REPO / 'outputs' / 'predictions' / model / f'{uid}.png',
        _REPO / 'outputs' / 'predictions' / safe / f'{uid}.png',
        DATA_ROOT / 'predictions' / safe / f'{uid}.png',
        _REPO / 'release' / 'predictions' / safe / f'{uid}.png',
    ])

    return first_existing(candidates)


