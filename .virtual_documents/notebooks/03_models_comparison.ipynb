            'model': model_name,
            'shape_ok': False,
            'foreground_pixels': np.nan,
            'pred_components_min3': np.nan,
        })
        continue

    shape_ok = (mask.shape == anchor_gt_bin.shape)

    qc_rows.append({
        'model': model_name,
        'shape_ok': shape_ok,
        'foreground_pixels': int(mask.sum()),
        'pred_components_min3': count_components(mask, min_area=3),
    })

