# ==============================================================================
# configs/paths.local.yaml
# ==============================================================================
# Longleaf-local paths for Poorya's assembled ecDNA benchmark dataset.
# This file is machine-specific and MUST remain gitignored.
#
# How this file is merged:
#   load_config() deep-merges the "paths:" block here over the "paths:" block
#   in default.yaml. Every key here overrides its default.yaml counterpart.
# ==============================================================================

paths:

  # ----------------------------------------------------------------------------
  # Data root and modality directories
  # ----------------------------------------------------------------------------

  data_root: /work/users/b/e/behnamie/ecDNA_Data/bioimage_archive

  rgb_dir:      /work/users/b/e/behnamie/ecDNA_Data/bioimage_archive/rgb
  dapi_dir:     /work/users/b/e/behnamie/ecDNA_Data/bioimage_archive/dapi
  # GT folder on disk is named gt_image — intentional.
  gt_mask_dir:  /work/users/b/e/behnamie/ecDNA_Data/bioimage_archive/gt_image
  roi_mask_dir: /work/users/b/e/behnamie/ecDNA_Data/bioimage_archive/roi_mask

  # Optional full-dataset annotation representations (for metadata / QC scripts).
  gt_npz_dir:    /work/users/b/e/behnamie/ecDNA_Data/bioimage_archive/gt_npz
  gt_coords_dir: /work/users/b/e/behnamie/ecDNA_Data/bioimage_archive/gt_coords


  # ----------------------------------------------------------------------------
  # Benchmark metadata and QC outputs
  # ----------------------------------------------------------------------------

  metadata_csv:    /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/release/manifests/metadata.csv
  counts_csv:      /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/release/manifests/counts_master.csv
  consistency_csv: /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/release/manifests/dl_master_metadata_stage1_step3_consistency.csv
  frozen_params_json: /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/configs/classical/stage3_frozen_params.json


  # classical after-opt masks 
  classical_masks:     /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/release/harmonized_masks/classical

  # classical before-opt masks
  classical_default_masks: /work/users/b/e/behnamie/ecDNA_Data/benchmark/predictions/classical_default

  # where to write results for comparison run
  frozen_results_dir: /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/outputs/classical_bfr_aft

  # ----------------------------------------------------------------------------
  # Fixed train / val / test splits
  # ----------------------------------------------------------------------------

  split_dir: release/split_files
  splits:
    train: release/split_files/train_ids.csv
    val:   release/split_files/val_ids.csv
    test:  release/split_files/test_ids.csv


  # ----------------------------------------------------------------------------
  # Prediction mask directories — RAW inputs (kept for provenance)
  # ----------------------------------------------------------------------------

  mia_raw_masks:           /work/users/b/e/behnamie/ecDNA_Data/benchmark/predictions/mia
  label_engine_raw_masks:  /work/users/b/e/behnamie/ecDNA_Data/benchmark/predictions/label_engine
  ecseg_raw_masks:         /work/users/b/e/behnamie/ecDNA_Data/benchmark/predictions/ecseg
  classical_default_masks:   /work/users/b/e/behnamie/ecDNA_Data/benchmark/predictions/classical_default
  classical_optimised_masks: /work/users/b/e/behnamie/ecDNA_Data/benchmark/predictions/classical_optimised


  # ----------------------------------------------------------------------------
  # Prediction mask directories — HARMONIZED canonical format (used by benchmark)
  # All masks: single-channel uint8 PNG, values {0,255}, min_area=3 applied.
  # ----------------------------------------------------------------------------

  # External baselines: harmonized by one-shot script (2026-05-04)
  ecseg_masks:         /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/release/harmonized_masks/ecseg
  mia_masks:           /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/release/harmonized_masks/mia
  label_engine_masks:  /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/release/harmonized_masks/label_engine

  # Classical optimized: written directly by run_classical
  classical_masks:     /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/release/harmonized_masks/classical
  classical_default_masks:   /work/users/b/e/behnamie/ecDNA_Data/benchmark/predictions/classical_default
  
  # ecCount: written directly by run_eccount
  eccount_threshold_masks: /work/users/b/e/behnamie/ecDNA_Data/benchmark/predictions/eccount_threshold
  eccount_peaks_masks:     /work/users/b/e/behnamie/ecDNA_Data/benchmark/predictions/eccount_peaks


  # ----------------------------------------------------------------------------
  # ecCount training + inference paths
  # ----------------------------------------------------------------------------

  eccount_out_dir:    /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/outputs/eccount_training
  eccount_checkpoint: /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/outputs/eccount_training/best_model.pt


  # ----------------------------------------------------------------------------
  # Repo-level output roots
  # ----------------------------------------------------------------------------

  results_root:              /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/release
  logs_root:                 /proj/brunk_ecdna_cv_project/Poorya/ecdna-bench/logs
  baseline_predictions_root: release/baseline_predictions